	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_orders.csv"), [Delimiter = ",", Columns = 21, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				            {"order_id", type text},
				            {"customer_unique_id", type text},
				            {"customer_state", type text},
				            {"order_status", type text},
				            {"is_delivered", Int64.Type},
				            {"purchase_date", type date},
				            {"purchase_ts", type datetime},
				            {"delivered_date", type date},
				            {"estimated_date", type date},
				            {"delivery_days", Int64.Type},
				            {"days_vs_estimate", Int64.Type},
				            {"is_late", Int64.Type},
				            {"delivery_status", type text},
				            {"lateness_bucket", type text},
				            {"item_count", Int64.Type},
				            {"order_revenue", Currency.Type},
				            {"order_freight", Currency.Type},
				            {"payment_value", Currency.Type},
				            {"main_payment_type", type text},
				            {"max_installments", Int64.Type},
				            {"review_score", type number}
				        },
				        "en-US"
				    )
				in
				    Typed

	annotation PBI_ResultType = Table
