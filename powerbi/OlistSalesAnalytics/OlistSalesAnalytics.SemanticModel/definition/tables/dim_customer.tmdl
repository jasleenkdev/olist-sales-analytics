	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customer.csv"), [Delimiter = ",", Columns = 14, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {
				            {"customer_unique_id", type text},
				            {"customer_city", type text},
				            {"customer_state", type text},
				            {"customer_zip_code_prefix", type text},
				            {"first_order_date", type date},
				            {"last_order_date", type date},
				            {"delivered_orders", Int64.Type},
				            {"is_repeat_customer", Int64.Type},
				            {"recency_days", Int64.Type},
				            {"lifetime_revenue", Currency.Type},
				            {"r_score", Int64.Type},
				            {"f_score", Int64.Type},
				            {"m_score", Int64.Type},
				            {"rfm_segment", type text}
				        },
				        "en-US"
				    )
				in
				    Typed

	annotation PBI_ResultType = Table
