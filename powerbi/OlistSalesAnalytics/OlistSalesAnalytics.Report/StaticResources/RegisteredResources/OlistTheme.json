{
  "name": "OlistTheme",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#898781",
  "background": "#fcfcfb",
  "backgroundLight": "#f9f9f7",
  "backgroundNeutral": "#e1e0d9",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#104281",
  "center": "#5598e7",
  "minimum": "#cde2fb",
  "textClasses": {
    "callout": {"fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b"},
    "title": {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b"},
    "header": {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b"},
    "label": {"fontSize": 10, "fontFace": "Segoe UI", "color": "#52514e"}
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{"show": true, "color": {"solid": {"color": "#fcfcfb"}}, "transparency": 0}],
        "border": [{"show": true, "color": {"solid": {"color": "#e1e0d9"}}, "radius": 6}],
        "title": [{"show": true, "fontColor": {"solid": {"color": "#0b0b0b"}}, "fontSize": 12, "alignment": "left"}],
        "categoryAxis": [{"gridlineShow": false, "labelColor": {"solid": {"color": "#898781"}}}],
        "valueAxis": [{"gridlineShow": true, "gridlineColor": {"solid": {"color": "#e1e0d9"}}, "labelColor": {"solid": {"color": "#898781"}}}]
      }
    },
    "page": {
      "*": {
        "background": [{"color": {"solid": {"color": "#f9f9f7"}}, "transparency": 0}]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{"strokeWidth": 2}]
      }
    },
    "card": {
      "*": {
        "labels": [{"color": {"solid": {"color": "#0b0b0b"}}, "fontSize": 24}],
        "categoryLabels": [{"show": true, "color": {"solid": {"color": "#52514e"}}, "fontSize": 10}]
      }
    }
  }
}
